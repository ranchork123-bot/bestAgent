{
  "manifest_version": 3,
  "name": "Hubtique OS Agent",
  "version": "1.0.0",
  "description": "Browser automation and AI assistant for Hubtique OS",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Hubtique OS",
    "default_popup": "index.html"
  }
}
